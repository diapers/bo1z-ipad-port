<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements embedded in the main executable's ad-hoc signature by package.sh.
  TrollStore keeps entitlements a binary is fake-signed with when it re-signs on install.

  NOT included on purpose: dynamic-codesigning. TrollStore's README lists it as one of
  three entitlements that are banned on iOS 15+ with A12 or newer chips. Apps signed with
  it crash on launch, and the M1 counts as A12-or-newer. JIT under TrollStore uses
  get-task-allow plus TrollStore's "Open with JIT" or apple-magnifier://enable-jit
  instead. That sets CS_DEBUGGED for the process, which lets W^X (RW then RX) mprotect
  JIT work. Details are in ios/IOS_RISKS.md.
-->
<plist version="1.0">
<dict>
	<!-- Required for TrollStore's "Open with JIT" / enable-jit URL scheme. -->
	<key>get-task-allow</key>
	<true/>
	<!-- Higher jetsam limit (check os_proc_available_memory() at runtime). -->
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
	<!-- Full 64-bit VA ("jumbo" map). Without it, devices with more than 3 GiB RAM get about 7.4 GiB of VA. -->
	<key>com.apple.developer.kernel.extended-virtual-addressing</key>
	<true/>
</dict>
</plist>
